{
  "name": "uberis",
  "version": "2.0.0",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --ignoreConfig --target ES2022 --module commonjs --esModuleInterop --skipLibCheck --types node --outDir /tmp/uberis-verify scripts/verify-simulation.ts && node /tmp/uberis-verify/scripts/verify-simulation.js",
    "update:main": "npx eas-cli@latest update --branch main --environment preview --message \"Uberis v2.0 (SDK 58)\"",
    "postinstall": "setup-skia-web public"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
