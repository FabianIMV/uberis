{
  "expo": {
    "name": "Synthetic Life",
    "slug": "uberis",
    "version": "1.0.0",
    "platforms": ["ios"],
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "synthetic-life",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.syntheticlife"
    },
    "android": {
      "package": "com.yourname.syntheticlife"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/6af26cf3-193f-48c5-9b30-94fd99721d58"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "anthropicApiKey": "YOUR-ANTHROPIC-API-KEY",
      "eas": {
        "projectId": "6af26cf3-193f-48c5-9b30-94fd99721d58"
      }
    }
  }
}
