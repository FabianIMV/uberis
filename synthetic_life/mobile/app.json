{
  "expo": {
    "name": "Uberis",
    "slug": "uberis",
    "owner": "fabianimv",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "uberis",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#040814",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fabianimv.uberis"
    },
    "android": {
      "backgroundColor": "#040814",
      "package": "com.fabianimv.uberis"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#040814"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/6af26cf3-193f-48c5-9b30-94fd99721d58"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "anthropicApiKey": "",
      "eas": {
        "projectId": "6af26cf3-193f-48c5-9b30-94fd99721d58"
      }
    }
  }
}
