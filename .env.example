# Uberis environment configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API key for entity consciousness
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override the default SQLite database URL
# DATABASE_URL=sqlite+aiosqlite:///./uberis.db

# Optional: Override the LLM model (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Backend host/port
# HOST=0.0.0.0
# PORT=8000
